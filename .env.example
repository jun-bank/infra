# jun-bank/infra — environment template. Copy to .env (gitignored) and fill in.
# This file contains PLACEHOLDERS ONLY. No real secrets, no real private IPs are
# ever committed (ADR-027 DO-2/DO-14; requirement-spec 경계·불변식: 사설 IP 0).

# --- role (ADR-027 DO-21). Single binary; this host's role is set here. --------
# main  (.9): HTTP receiver + orchestration + local deploy.
# agent (.158/.164): receives signed commands from main and deploys its own host.
# Unset or unknown => the binary refuses to start (fail-closed).
ROLE=__main_or_agent__

# --- deploy-agent HTTP receiver (LAN side; the edge proxies to it) -------------
# host:port — filled in .env only. No concrete address or port in this template.
AGENT_LISTEN_ADDR=__PLACEHOLDER_HOST__:__PLACEHOLDER_PORT__

# --- deploy request body cap in bytes (ADR-027 DO-15 ⑵; value is [구현 검증]). --
# Optional — defaults to a safe cap when unset. Not a secret; tuned with the edge
# limits so a normal deploy request never trips it while a flood is cut.
AGENT_MAX_BODY_BYTES=__PLACEHOLDER_BYTES__

# --- HMAC signing key (gate 1; DO-2). Provisioned from the CI secret store. -----
# Owned by IV-14 ⑶ — issuance/rotation. Never commit the real value.
AGENT_HMAC_KEY=__PLACEHOLDER__

# --- clock skew tolerance for request freshness (DO-10 ⑵; value is [구현 검증]). -
# Optional Go duration (e.g. 60s) — defaults to a safe tolerance when unset. Sets how
# far issuedAt/expiresAt may drift against local time before a request is rejected.
AGENT_CLOCK_SKEW=__PLACEHOLDER_DURATION__

# --- OIDC claim matrix expectations (DO-11). Values are identifiers, not secrets,
# but are environment-specific, so they live here rather than in code. ----------
OIDC_ISSUER=__PLACEHOLDER_ISSUER__
OIDC_AUDIENCE=__PLACEHOLDER_AUDIENCE__
OIDC_REPOSITORY=__owner/repo__
OIDC_REPOSITORY_ID=__PLACEHOLDER_ID__
OIDC_OWNER_ID=__PLACEHOLDER_ID__
# Comma-separated allowlist of deployable refs (default = default branch only).
OIDC_REF_ALLOWLIST=__refs/heads/main__
# The single deploy workflow ref — a sibling workflow with a valid token must not deploy.
OIDC_JOB_WORKFLOW_REF=__owner/repo/.github/workflows/deploy.yml@refs/heads/main__

# --- per-host SSH (gate 2; DO-3/DO-14). Per-host keys; addresses are private. ---
# Fill with LAN addresses and per-host key paths in .env (never here).
SSH_HOST_CORE_ADDR=__PLACEHOLDER_LAN_ADDR__
SSH_HOST_SETTLEMENT_ADDR=__PLACEHOLDER_LAN_ADDR__
SSH_HOST_LEDGER_ADDR=__PLACEHOLDER_LAN_ADDR__
SSH_HOST_CORE_KEY=__PLACEHOLDER_KEY_PATH__
SSH_HOST_SETTLEMENT_KEY=__PLACEHOLDER_KEY_PATH__
SSH_HOST_LEDGER_KEY=__PLACEHOLDER_KEY_PATH__

# --- deploy schema DB connection (ADR-022 DT-10; LAN only, no core/settlement/
# ledger access). Password is provisioned out-of-band from the secret store. ----
DEPLOY_DB_DSN=deploy_agent:__PLACEHOLDER_PW__@tcp(__PLACEHOLDER_LAN_ADDR__:__PLACEHOLDER_PORT__)/deploy

# --- privileged execution (ADR-027 DO-23; #15 S2-3). Enumerated docker commands
# only, no raw shell. The agent prefixes each command with DEPLOY_SUDO_PREFIX. ---
# Space-split prefix. Empty => run docker directly (dev machine in the docker group).
# Real hosts: "sudo -S" so the sudo password is read from the command's stdin.
DEPLOY_SUDO_PREFIX=__empty_or_sudo_-S__
# sudo password, injected to child stdin ONLY when the prefix is non-empty. Provisioned
# out-of-band; never commit the real value. Leave empty on the docker-group dev machine.
DEPLOY_SUDO_PASSWORD=__PLACEHOLDER__

# --- compose target (DO-4/DO-18). The green project runs on its own compose project
# name so `down` only ever targets green (never blue). Paths/names are host-local. ---
DEPLOY_COMPOSE_FILE=__PLACEHOLDER_COMPOSE_PATH__
DEPLOY_COMPOSE_PROJECT=__PLACEHOLDER_GREEN_PROJECT__
# env var name the compose file reads for the digest-pinned image ref
# (image: ${DEPLOY_IMAGE_REF}). Optional — defaults to DEPLOY_IMAGE_REF.
DEPLOY_IMAGE_ENV=__optional_default_DEPLOY_IMAGE_REF__

# --- per-target image repositories (DO-18 ⑵). The pinned ref = <repo>@<imageDigest>
# from the signed manifest. Set the repo for whichever target(s) this host deploys;
# at least one is required (fail-closed at boot otherwise). Not secrets. -----------
IMAGE_CORE=__PLACEHOLDER_REGISTRY/core__
IMAGE_SETTLEMENT=__PLACEHOLDER_REGISTRY/settlement__
IMAGE_LEDGER=__PLACEHOLDER_REGISTRY/ledger__

# --- CD-1 readiness probe (operations/cicd.md §2.1; N·T·D are [구현 검증] CDV-1). --
# HTTP GET readiness URL of the green process. 2xx consecutive N times within deadline
# D, with a stable container restart count, = healthy. Required (fail-closed at boot).
DEPLOY_HEALTH_URL=__PLACEHOLDER_GREEN_READINESS_URL__
# Optional tuning — safe defaults when unset (N=3, interval=2s, timeout=3s, deadline=60s).
DEPLOY_HEALTH_SUCCESS_THRESHOLD=__optional_int__
DEPLOY_HEALTH_INTERVAL=__optional_duration__
DEPLOY_HEALTH_TIMEOUT=__optional_duration__
DEPLOY_HEALTH_DEADLINE=__optional_duration__
# Container name inspected for restart count (green-fraud defense — CD-1). Optional but
# recommended; when empty the restart-stability check is skipped.
DEPLOY_HEALTH_CONTAINER=__PLACEHOLDER_GREEN_CONTAINER__
