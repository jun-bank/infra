# jun-bank/infra — environment template. Copy to .env (gitignored) and fill in.
# This file contains PLACEHOLDERS ONLY. No real secrets, no real private IPs are
# ever committed (ADR-027 DO-2/DO-14; requirement-spec 경계·불변식: 사설 IP 0).

# --- role (ADR-027 DO-21). Single binary; this host's role is set here. --------
# main  (.9): HTTP receiver + orchestration + local deploy.
# agent (.158/.164): receives signed commands from main and deploys its own host.
# Unset or unknown => the binary refuses to start (fail-closed).
ROLE=__main_or_agent__

# --- deploy-agent HTTP receiver (LAN side; the edge proxies to it) -------------
# host:port — filled in .env only. No concrete address or port in this template.
AGENT_LISTEN_ADDR=__PLACEHOLDER_HOST__:__PLACEHOLDER_PORT__

# --- deploy request body cap in bytes (ADR-027 DO-15 ⑵; value is [구현 검증]). --
# Optional — defaults to a safe cap when unset. Not a secret; tuned with the edge
# limits so a normal deploy request never trips it while a flood is cut.
AGENT_MAX_BODY_BYTES=__PLACEHOLDER_BYTES__

# --- HMAC signing key (gate 1; DO-2). Provisioned from the CI secret store. -----
# Owned by IV-14 ⑶ — issuance/rotation. Never commit the real value.
AGENT_HMAC_KEY=__PLACEHOLDER__

# --- /internal admin-surface HMAC key (route-switch authorization; gateway#6). ---
# canonical-v1 서명으로 게이트웨이 /internal 라우트 조회·전환 호출의 발신자를 증명한다.
# 배포 게이트 1의 AGENT_HMAC_KEY와는 **별도 키**다(관리 표면 ≠ 배포 요청 — 다른 신뢰 경계).
# 게이트웨이의 GATEWAY_INTERNAL_HMAC_KEY와 **같은 값**이어야 한다(서명자↔검증기 공유 비밀).
# DEPLOY_GATEWAY_URL이 설정되면(블루-그린 모드) 필수 — 없으면 기동을 거부한다(무서명 폴백
# 제거 · fail-closed). Never commit the real value.
GATEWAY_INTERNAL_HMAC_KEY=__PLACEHOLDER__

# --- clock skew tolerance for request freshness (DO-10 ⑵; value is [구현 검증]). -
# Optional Go duration (e.g. 60s) — defaults to a safe tolerance when unset. Sets how
# far issuedAt/expiresAt may drift against local time before a request is rejected.
AGENT_CLOCK_SKEW=__PLACEHOLDER_DURATION__

# --- OIDC claim matrix expectations (DO-11). Values are identifiers, not secrets,
# but are environment-specific, so they live here rather than in code. ----------
# OIDC_ISSUER is also the JWKS discovery base: the agent GETs
# <OIDC_ISSUER>/.well-known/openid-configuration over HTTPS to find jwks_uri, then
# fetches the signing public keys. Must be https (fail-closed at boot otherwise).
OIDC_ISSUER=__PLACEHOLDER_ISSUER__
OIDC_AUDIENCE=__PLACEHOLDER_AUDIENCE__
OIDC_OWNER_ID=__PLACEHOLDER_ID__
# Comma-separated allowlist of deployable refs (default = default branch only).
OIDC_REF_ALLOWLIST=__refs/heads/main__

# --- which repository may deploy which target (repo↔target binding, infra#28) ---
# A valid token proves "this came from our pipeline"; it does not prove "this repo may
# deploy THIS target". With four deploy targets, core's workflow holding a valid token
# must not be able to deploy gateway. So each repository is pinned to exactly one target.
#
# Two ways to declare it — exactly one, never both (the agent refuses to boot if both
# are set, and refuses to boot if neither is):
#
# ⑴ Allowlist file (multi-repo — the .9 form). One entry per line:
#      repository|repository_id|job_workflow_ref|target
#      jun-bank/infra|123456|jun-bank/infra/.github/workflows/deploy.yml@refs/heads/main|core
#    Blank lines and whole-line comments (#) are skipped; trailing comments are NOT
#    supported (a "#" mid-line is part of the value and will fail validation loudly).
#    Fields are trimmed. repository_id is the lookup key and must be a positive decimal
#    integer without leading zeros; target must be one of core|settlement|ledger|gateway;
#    repository_id, repository name and target must each be unique across entries.
#    The file is read once at boot — updating it means restarting the agent.
OIDC_ALLOWLIST_FILE=__optional_path_to_allowlist__
#
# ⑵ Single-repo env set (the pre-#28 form — kept for a one-repo host). All four must be
#    set together, including OIDC_ALLOWED_TARGET; they are normalized into a one-entry
#    allowlist so the binding holds in this mode too. Left commented out on purpose: the
#    file above is the default, and an uncommented value here (even a placeholder) makes
#    the agent refuse to boot for having two sources of truth. Uncomment all four, or none.
#OIDC_REPOSITORY=__owner/repo__
#OIDC_REPOSITORY_ID=__PLACEHOLDER_ID__
# The single deploy workflow ref — a sibling workflow with a valid token must not deploy.
#OIDC_JOB_WORKFLOW_REF=__owner/repo/.github/workflows/deploy.yml@refs/heads/main__
# The one target this repository may deploy: core|settlement|ledger|gateway.
#OIDC_ALLOWED_TARGET=__core__
# JWKS signing-key cache TTL (value is [구현 검증]; sized against the issuer's key
# rotation cadence). Optional Go duration — defaults to a safe TTL (10m) when unset.
# Unknown kids trigger a re-fetch regardless of TTL (rotation), so this is the
# re-validation interval for already-known keys.
OIDC_JWKS_CACHE_TTL=__optional_duration__

# --- per-host SSH (gate 2; DO-3/DO-14). Per-host keys; addresses are private. ---
# Fill with LAN addresses and per-host key paths in .env (never here).
SSH_HOST_CORE_ADDR=__PLACEHOLDER_LAN_ADDR__
SSH_HOST_SETTLEMENT_ADDR=__PLACEHOLDER_LAN_ADDR__
SSH_HOST_LEDGER_ADDR=__PLACEHOLDER_LAN_ADDR__
SSH_HOST_CORE_KEY=__PLACEHOLDER_KEY_PATH__
SSH_HOST_SETTLEMENT_KEY=__PLACEHOLDER_KEY_PATH__
SSH_HOST_LEDGER_KEY=__PLACEHOLDER_KEY_PATH__

# --- deploy schema DB connection (ADR-022 DT-10; LAN only, no core/settlement/
# ledger access). Password is provisioned out-of-band from the secret store. ----
DEPLOY_DB_DSN=deploy_agent:__PLACEHOLDER_PW__@tcp(__PLACEHOLDER_LAN_ADDR__:__PLACEHOLDER_PORT__)/deploy

# --- privileged execution (ADR-027 DO-23; #15 S2-3). Enumerated docker commands
# only, no raw shell. The agent prefixes each command with DEPLOY_SUDO_PREFIX. ---
# Space-split prefix. Empty => run docker directly (dev machine in the docker group).
# Real hosts: "sudo -S" so the sudo password is read from the command's stdin.
DEPLOY_SUDO_PREFIX=__empty_or_sudo_-S__
# sudo password, injected to child stdin ONLY when the prefix is non-empty. Provisioned
# out-of-band; never commit the real value. Leave empty on the docker-group dev machine.
DEPLOY_SUDO_PASSWORD=__PLACEHOLDER__

# --- compose target (DO-4/DO-18). The green project runs on its own compose project
# name so `down` only ever targets green (never blue). Paths/names are host-local. ---
DEPLOY_COMPOSE_FILE=__PLACEHOLDER_COMPOSE_PATH__
DEPLOY_COMPOSE_PROJECT=__PLACEHOLDER_GREEN_PROJECT__
# env var name the compose file reads for the digest-pinned image ref
# (image: ${...}). REQUIRED whenever embedded compose is required (i.e. unless
# DEPLOY_ALLOW_LEGACY_COMPOSE=1); optional only on a transitional host, where it
# defaults to DEPLOY_IMAGE_REF.
# CONTRACT: this value must be EXACTLY the variable name the canonical compose file
# uses — the embedded-compose check requires `image: ${<this value>}` as an exact
# match, so a mismatch is not a fallback, it is a rejected deploy every time.
# Current .9 compose files use CORE_IMAGE.
DEPLOY_IMAGE_ENV=__PLACEHOLDER_e_g_CORE_IMAGE__
# compose service name of the app this host deploys (DO-16 ⑶ postcondition binding).
# The image check, partial-boot check and the CD-1 restart check look ONLY at containers
# carrying com.docker.compose.service=<this value>, so a sidecar/orphan running the pinned
# digest can never stand in for the app. Required when DEPLOY_GATEWAY_URL is set (boot is
# refused otherwise); optional on the single-path host — when unset the checks fall back to
# the whole compose project (weaker) and boot logs a warning. Current .9 structure: "app".
# CONSTRAINT: one value binds EVERY target this host deploys (the core blue/green slots AND
# the gateway single path). Each of those compose files must name its app service exactly
# this — if one differs, that target's deploys fail wholesale with "target service has 0
# containers" (fail-closed, never a silent pass). Keep the service name uniform across the
# host's compose files; per-target service names would need a per-target env.
# REQUIRED (single path included) whenever embedded compose is required, i.e. unless
# DEPLOY_ALLOW_LEGACY_COMPOSE=1: it is the host side of the CP-3 three-way match
# (manifest.appService == compose service name == this value). With it unset there is
# nothing to check the signed value against, so boot is refused.
DEPLOY_APP_SERVICE=__PLACEHOLDER_APP_SERVICE_e_g_app__

# --- per-target image repositories (DO-18 ⑵). The pinned ref = <repo>@<imageDigest>
# from the signed manifest. Set the repo for whichever target(s) this host deploys;
# at least one is required (fail-closed at boot otherwise). Not secrets. -----------
IMAGE_CORE=__PLACEHOLDER_REGISTRY/core__
IMAGE_SETTLEMENT=__PLACEHOLDER_REGISTRY/settlement__
IMAGE_LEDGER=__PLACEHOLDER_REGISTRY/ledger__

# --- CD-1 readiness probe (operations/cicd.md §2.1; N·T·D are [구현 검증] CDV-1). --
# HTTP GET readiness URL of the green process. 2xx consecutive N times within deadline
# D, with a stable container restart count, = healthy. Required (fail-closed at boot).
# The restart-count containers for the green-fraud defense (CD-1) are derived from the
# compose project (DEPLOY_COMPOSE_PROJECT), not named here — the defense is always on.
DEPLOY_HEALTH_URL=__PLACEHOLDER_GREEN_READINESS_URL__
# Optional tuning — safe defaults when unset (N=3, interval=2s, timeout=3s, deadline=60s).
# Invalid values (non-int / non-duration, N<1, non-positive) are rejected at boot (fail-fast).
DEPLOY_HEALTH_SUCCESS_THRESHOLD=__optional_int__
DEPLOY_HEALTH_INTERVAL=__optional_duration__
DEPLOY_HEALTH_TIMEOUT=__optional_duration__
DEPLOY_HEALTH_DEADLINE=__optional_duration__

# --- dispatch phase budget (P3; value is [구현 검증]). Upper bound on pull+up so a slow
# pull cannot outrun the deploy-window lock lease. Optional Go duration — defaults to a
# safe bound (120s) when unset. Sized against image size; the boot check requires
# lease >= phaseBudget + health deadline D + cleanup + slack (fail-closed otherwise). ----
DEPLOY_DISPATCH_PHASE_BUDGET=__optional_duration__

# =============================================================================
# compose 동봉 실행 결박 (infra#19 · ADR-030 CP-1~7)
# =============================================================================
# 서명된 manifest가 compose 내용을 동봉하고, agent가 해시 선대조 → 구조 allowlist →
# workspace 기록 → **그 기록으로만** up 한다. 낡거나 변조된 호스트 compose 파일이 실행될
# 수 없게 하는 것이 목적이므로, 아래 변수들은 전부 "무엇을 허용하는가"를 닫는 쪽으로 쓴다.
# 형식이 어긋나면 기본값으로 삼키지 않고 기동을 거부한다(fail-closed).

# --- candidate·applied가 사는 agent 전용 디렉터리 (CP-2). ----------------------
# 계약: 절대경로 · 경로에 심볼릭 링크 없음 · 디렉터리 · 모드 0700 · 이 프로세스의 uid 소유.
# 하나라도 어긋나면 기동을 거부한다 — 이 배타성이 무너지면 "검증한 바이트를 그대로 실행한다"가
# 다른 사용자의 쓰기 권한에 기대게 된다.
#   <ws>/<target>/<blue|green|single>/compose.sha256-<64hex>.yml   불변 candidate(0644)
#   <ws>/<target>/applied.json                                     성공 승격 인덱스(0600)
# DEPLOY_ALLOW_LEGACY_COMPOSE=1 이 아니면 필수다(동봉이 기본).
DEPLOY_WORKSPACE=__PLACEHOLDER_ABS_PATH_0700__

# --- 무동봉(호스트 compose 파일) 배포의 명시 opt-in — 과도기 전용 (R7). ---------
# 값은 0 또는 1만 받는다("true"·"yes"는 기동 거부: 오타 하나가 조용히 0으로 접히면
# 운영자가 켰다고 믿는 경로가 실은 꺼져 있게 된다). 미설정 = 0 = 동봉 필수.
# 1일 때만 동봉 없는 manifest가 수락되며, 그 요청은 WARN 로그와 이력 detail
# (composePath=LEGACY_COMPOSE_PATH)로 매번 드러난다 — 조용한 폴백은 없다.
# 이관 순서: agent 신버전(=1) → CD가 동봉 발행 → e2e → 이 변수 제거(동봉 필수 복귀).
DEPLOY_ALLOW_LEGACY_COMPOSE=__0_or_1__

# --- compose가 pass-through로 요구할 수 있는 environment 키 (CP-5·CP-7). --------
# 형식: target:KEY,target:KEY,…   (예: core:CORE_BLUE_URI,core:CORE_GREEN_URI)
# **target별**인 이유: 전역 합집합으로 두면 gateway가 등재한 키를 core의 compose가 끌어 쓸
# 수 있어 대상마다 닫아 둔 목록이 사실상 하나로 합쳐진다.
# 동봉 compose에는 값이 아니라 키만 실린다(environment: ["CORE_BLUE_URI"]) — 값의 소유는
# 이 .env이며, agent가 자기 프로세스 env에서 읽어 compose subprocess로 넘긴다. 그래서
# 등재한 키의 값이 이 파일에 없으면 **기동을 거부한다**(빈 값으로 뜨는 조용한 오설정 차단).
# 시크릿은 여기 등재하지 않는다(CF-6 — compose에 시크릿 금지).
DEPLOY_COMPOSE_ENV_ALLOW=__target:KEY,target:KEY__

# --- compose가 마운트할 수 있는 볼륨 (CP-7). -----------------------------------
# 형식: target:src:dst:mode,…   (예: core:/srv/jun-bank/data:/app/data:rw)
# 프리픽스가 아니라 **정확 튜플**이다 — 프리픽스 허용은 그 아래 경로 전체를 여는 것과 같다.
# src·dst는 절대경로이자 정규형(Clean)이어야 하고, mode는 ro|rw만 받는다. 검증 시 src의
# 심볼릭 링크를 해소해 선언 경로와 같은지 다시 본다(등재 경로가 다른 곳을 가리키는 탈출 차단).
# 볼륨이 필요 없으면 비워 둔다(빈 값 = 어떤 볼륨도 허용하지 않음).
DEPLOY_COMPOSE_VOLUME_ALLOW=__target:src:dst:mode__

# --- 슬롯별 호스트 포트 — compose의 ${DEPLOY_HOST_PORT} 자리에 주입된다. ---------
# 동봉 compose의 ports는 "${DEPLOY_HOST_PORT}:8080" 한 형식만 허용되므로, 슬롯마다 다른
# 호스트 포트는 compose가 아니라 이 값들이 정한다(compose 파일은 슬롯마다 같다).
# 값은 1~65535 정수여야 한다(그 밖은 기동 거부 — 임의 문자열이 포트 매핑 문법에 들어간다).
# 블루-그린 모드에서는 BLUE/GREEN을, 단일 경로(target=gateway)에서는 DEPLOY_HOST_PORT를 쓴다.
DEPLOY_HOST_PORT_BLUE=__PLACEHOLDER_PORT__
DEPLOY_HOST_PORT_GREEN=__PLACEHOLDER_PORT__
DEPLOY_HOST_PORT=__PLACEHOLDER_PORT__
